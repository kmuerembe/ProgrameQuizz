# ============================================================
# ProgrameMoz - Environment Variables Example
# ============================================================

# Database Configuration
# ---------------------
# PostgreSQL connection string (format: postgres://user:password@host:port/database)
# Para desenvolvimento local, use: postgres://programe_user:senha_segura@localhost:5432/programe_moz
DATABASE_URL=postgres://utilizador:senha_segura@localhost:5432/programe_moz

# Application Settings
# -------------------
# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente (development, production, test)
NODE_ENV=development

# JWT Secret (gera tokens para autenticação)
# Substitua por uma string segura e longa antes de produzir
JWT_SECRET=sua_chave_secreta_jwt_mais_que_32_caracteres_aqui

# Cookie Configuration
# -------------------
# Tempo de vida do cookie de sessão (em minutos)
SESSION_MAX_AGE=24h

# CORS Configuration
# -----------------
# Origens permitidas para acesso cross-origin
# Em desenvolvimento, pode incluir o endpoint local
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Notas de Segurança
# ------------------
# 1. NUNCA comprometa este ficheiro no repositório público
# 2. Utilize variáveis de ambiente reais do seu sistema operativo
# 3. Gere um JWT_SECRET único e mantenha-o em segredo
# 4. Considere usar um gestor de secrets (ex: dotenv, aws-secrets-manager)
# ============================================================