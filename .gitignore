# ProgrameMoz - GitIgnore
# ----------------------
# Dependências node_modules
node_modules/
package-lock.json

# Environment variables
.env

# Logs
*.log

# Database dump (exceto scripts de esquema e seed em sql/)
*.sql
!sql/*.sql

# Build artifacts
dist/
build/

# IDE files
.vscode/
.idea/

# Coverage
coverage/

# Runtime cache
*.pid
*.seed

# Environment sample (but not the actual file)
!.env.example